---
// A saved-link card as it looks out in the wild, before it lands in Kloom.
import type { Item } from './items';

type Props = { item: Item };
const { item } = Astro.props;
---

<div class="rounded-2xl bg-white p-3 shadow-xl ring-1 shadow-neutral-900/10 ring-neutral-200/80">
  {
    item.kind === 'video' && (
      <>
        {/* Real video goes in here later. */}
        <div data-video-slot class="relative aspect-video overflow-hidden rounded-xl bg-linear-to-br from-neutral-700 to-neutral-950">
          <span class="absolute inset-0 grid place-items-center">
            <span class="grid size-10 place-items-center rounded-full bg-white/90">
              <svg viewBox="0 0 12 14" class="ml-0.5 size-3.5 fill-neutral-900"><path d="M0 0v14l12-7z" /></svg>
            </span>
          </span>
          <span class="absolute right-2 bottom-2 rounded bg-black/70 px-1.5 py-0.5 text-[10px] font-medium text-white">{item.meta}</span>
        </div>
        <p class="mt-2.5 text-sm leading-snug font-medium">{item.title}</p>
        <p class="mt-0.5 text-xs text-neutral-500">{item.host}</p>
      </>
    )
  }
  {
    item.kind === 'shop' && (
      <>
        <div class:list={['relative aspect-4/3 rounded-xl bg-linear-to-br', item.grad]}>
          <span class="absolute top-2 left-2 rounded-full bg-white px-2 py-0.5 text-[11px] font-semibold">{item.price}</span>
        </div>
        <p class="mt-2.5 text-sm leading-snug font-medium">{item.title}</p>
        <p class="mt-0.5 text-xs text-neutral-500">{item.host}</p>
      </>
    )
  }
  {
    item.kind === 'tweet' && (
      <>
        <div class="flex items-center gap-2">
          <span class:list={['grid size-8 shrink-0 place-items-center rounded-full text-[11px] font-semibold text-white', item.avatar]}>{item.initials}</span>
          <div class="min-w-0 leading-tight">
            <p class="truncate text-[13px] font-semibold">{item.name}</p>
            <p class="truncate text-xs text-neutral-500">{item.handle}</p>
          </div>
        </div>
        <p class="mt-2.5 text-[13px] leading-snug">{item.title}</p>
      </>
    )
  }
  {
    item.kind === 'article' && (
      <>
        <div class="flex items-center gap-2 text-xs text-neutral-500">
          <span class="grid size-5 place-items-center rounded-md bg-neutral-100 text-[10px] font-semibold text-neutral-700">
            {item.host.charAt(0).toUpperCase()}
          </span>
          {item.host}
        </div>
        <p class="mt-2.5 text-base leading-snug font-semibold tracking-tight">{item.title}</p>
        <p class="mt-1 text-xs text-neutral-500">{item.meta}</p>
      </>
    )
  }
  {
    item.kind === 'music' && (
      <div class="flex items-center gap-3">
        <span class="grid size-14 shrink-0 place-items-center rounded-lg bg-linear-to-br from-emerald-400 to-emerald-700">
          <svg viewBox="0 0 16 14" class="size-5 fill-white">
            <rect x="0" y="5" width="3" height="9" rx="1" />
            <rect x="4.5" y="1" width="3" height="13" rx="1" />
            <rect x="9" y="7" width="3" height="7" rx="1" />
            <rect x="13" y="3" width="3" height="11" rx="1" />
          </svg>
        </span>
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold">{item.title}</p>
          <p class="truncate text-xs text-neutral-500">{item.meta}</p>
          <p class="truncate text-xs text-neutral-400">{item.host}</p>
        </div>
      </div>
    )
  }
  {
    item.kind === 'place' && (
      <div class="flex items-center gap-3">
        <span class="grid size-12 shrink-0 place-items-center rounded-lg bg-sky-100">
          <svg viewBox="0 0 16 20" class="size-5 fill-sky-600"><path d="M8 0a8 8 0 0 0-8 8c0 6 8 12 8 12s8-6 8-12a8 8 0 0 0-8-8zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" /></svg>
        </span>
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold">{item.title}</p>
          <p class="truncate text-xs text-neutral-500">{item.meta}</p>
        </div>
      </div>
    )
  }
</div>
