---
// Closing call to action. A dark card that echoes the privacy and Pro cards, so
// the page ends on the same surface it introduced them with. [data-dark] lets the
// glass navbar flip to its inverted palette while this scrolls under it.
import { SITE } from '../../data/site';
import { url } from '../../lib/url';
---

<section class="mx-auto max-w-3xl px-1 pb-24 sm:px-0">
  <div
    data-cta
    data-rise
    data-dark
    class="relative isolate overflow-hidden rounded-[32px] bg-neutral-900 px-6 py-16 text-center text-white sm:px-10 sm:py-20"
  >
    <!-- Soft glow behind the icon, and a faint grid that fades out at the edges. -->
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-60 [background-image:linear-gradient(rgb(255_255_255/0.07)_1px,transparent_1px),linear-gradient(90deg,rgb(255_255_255/0.07)_1px,transparent_1px)] [background-size:56px_56px] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_40%,#000_20%,transparent_75%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute top-0 left-1/2 -z-10 size-72 -translate-x-1/2 -translate-y-1/3 rounded-full bg-linear-to-br from-sky-400/25 via-indigo-400/15 to-transparent blur-3xl"
      aria-hidden="true"
    >
    </div>

    <img
      src={url('icon-256.png')}
      alt="Kloom app icon"
      width="96"
      height="96"
      class="mx-auto size-20 rounded-[22px] ring-1 ring-white/15 sm:size-24"
    />
    <h2 class="mt-8 text-3xl font-semibold tracking-tight text-balance sm:text-5xl">Give your links a calm home.</h2>
    <p class="mx-auto mt-5 max-w-md text-base leading-relaxed text-pretty text-white/70">
      Free on the App Store. No account, no setup — share your first link in seconds.
    </p>
    <a
      href={SITE.appStoreURL}
      class="mt-8 inline-flex h-12 items-center justify-center rounded-full bg-white px-7 text-base font-medium text-neutral-900 transition hover:bg-white/85"
    >
      Download on the App Store
    </a>
  </div>
</section>

<script>
  // Same reveal-on-scroll as the sections above it.
  const el = document.querySelector('[data-cta]');
  if (el) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.setAttribute('data-on', '');
          io.unobserve(e.target);
        }),
      { rootMargin: '0px 0px -12% 0px' },
    );
    io.observe(el);
  }
</script>
