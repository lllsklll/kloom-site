---
// The blog index. Newest post leads as a large card; the rest follow as a
// two-column grid of the same card, smaller.
import V2Layout from '../../layouts/V2Layout.astro';
import { getPosts, readingTime, formatDate } from '../../lib/blog';
import { url } from '../../lib/url';

const [latest, ...rest] = await getPosts();
---

<V2Layout
  title="Blog — Kloom"
  description="Guides to saving, sorting and finding links on iPhone, from the people who make Kloom."
>
  <section class="mx-auto max-w-3xl px-5 text-center">
    <p class="text-xs font-medium tracking-wider text-neutral-500 uppercase">Blog</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-6xl">Notes on keeping links.</h1>
    <p class="mx-auto mt-5 max-w-md text-base leading-relaxed text-pretty text-neutral-600">
      Guides to saving, sorting and finding what you read on iPhone.
    </p>
  </section>

  <div class="mx-auto mt-12 grid max-w-3xl gap-3 px-1 pb-32 sm:grid-cols-2 sm:px-0">
    {
      latest && (
        <a
          href={url(`blog/${latest.id}/`)}
          class="group relative rounded-3xl bg-white p-7 transition hover:-translate-y-0.5 hover:shadow-[0_8px_30px_rgb(0_0_0/0.06)] sm:col-span-2 sm:p-10"
        >
          <span class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-neutral-500">
            <span class="rounded-full bg-stone-100 px-2.5 py-1 font-medium text-neutral-900">{latest.data.category}</span>
            <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time>
            <span aria-hidden="true">·</span>
            <span>{readingTime(latest)}</span>
          </span>
          <span class="mt-6 block text-2xl font-semibold tracking-tight text-balance sm:text-4xl">{latest.data.title}</span>
          <span class="mt-4 block max-w-xl text-base leading-relaxed text-pretty text-neutral-600">
            {latest.data.description}
          </span>
          <span class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-neutral-900">
            Read the guide
            <svg viewBox="0 0 16 16" class="size-3.5 fill-none stroke-current stroke-[1.5] transition group-hover:translate-x-0.5" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </span>
        </a>
      )
    }
    {
      rest.map((post) => (
        <a
          href={url(`blog/${post.id}/`)}
          class="group relative flex flex-col rounded-3xl bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-[0_8px_30px_rgb(0_0_0/0.06)]"
        >
          <span class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-neutral-500">
            <span class="rounded-full bg-stone-100 px-2.5 py-1 font-medium text-neutral-900">{post.data.category}</span>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </span>
          <span class="mt-5 block text-lg font-semibold tracking-tight text-balance">{post.data.title}</span>
          <span class="mt-2 block text-sm leading-relaxed text-pretty text-neutral-600">{post.data.description}</span>
          <span class="mt-auto pt-6 text-xs text-neutral-500">{readingTime(post)}</span>
        </a>
      ))
    }
  </div>
</V2Layout>
