---
// The shell every page shares: the glass navbar, the page canvas, the footer.
// The homepage builds its own <head> (it has the intro script to run before
// paint); everything else comes through here.
import '../styles/v2.css';
import Nav from '../components/v2/Nav.astro';
import Footer from '../components/v2/Footer.astro';
import SEO, { type Article } from '../components/v2/SEO.astro';

interface Props {
  title: string;
  description: string;
  article?: Article;
  noindex?: boolean;
}

const { title, description, article, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={title} description={description} article={article} noindex={noindex} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen overflow-x-clip bg-canvas font-sans text-neutral-900 antialiased">
    <Nav />
    <main class="px-4 pt-32 sm:pt-40">
      <slot />
    </main>
    <Footer />
  </body>
</html>
